# Przykład konfiguracji; bez prawdziwych sekretów.
# Domyślnie program zapisuje prompt i kontekst bez wywołania modelu.
GENERATION_PROVIDER=none

# Opcjonalnie: klucz projektu Gemini API z potwierdzonym bezpłatnym dostępem.
# Wpisz klucz wyłącznie w lokalnym .env lub zmiennej środowiskowej.
GEMINI_API_KEY=

# Nazwę modelu ustalimy po sprawdzeniu dostępności w tym projekcie API.
GEMINI_MODEL=
